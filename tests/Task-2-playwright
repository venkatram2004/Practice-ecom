from playwright.sync_api import expect, sync_playwright

with sync_playwright() as p:
    browser = p.chromium.launch(headless=False)
    page = browser.new_page()
    page.goto("https://practicesoftwaretesting.com/")
    page.wait_for_timeout(3000)

    # 1. Search for a valid product
    search_input = page.locator('//input[@id="search-query"]')
    search_input.fill("Hammer")
    print("Search input value:", search_input.input_value())
    page.wait_for_timeout(2000)

    page.locator('button[data-test="search-submit"]').click()
    page.wait_for_timeout(3000)

    # Verify search results appear
    searched_product = page.locator('h5[data-test="product-name"]').first
    expect(searched_product).to_be_visible()
    print("Found Product in Search:", searched_product.text_content())

    # 2. Search for non-existent product
    search_input.fill("XYZNonExistent12345")
    page.locator('button[data-test="search-submit"]').click()
    page.wait_for_timeout(3000)

    # Verify empty/no-result state
    no_results = page.locator('div[data-test="search_completed_no_results"], text="There are no products found."')
    expect(no_results).to_be_visible()
    print("No result state displayed correctly")

    page.wait_for_timeout(5000)
    browser.close()
